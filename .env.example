# ---- Public tunnel (docker compose --profile public) ----
# Token from the Cloudflare Zero Trust dashboard. Empty = no public URL.
TUNNEL_TOKEN=

# ---- Server ----
# One place for the port: dev run, Docker and the tunnel all read it.
APP_HOST=127.0.0.1
APP_PORT=8077

# ---- LLM ----
# "ollama"  = a model on your own machine: no key, no quota, nothing leaves the
#             network (the pitch for an SME HR assistant), ~20-30 s per answer.
# "groq"    = hosted, free tier with no card, answers in seconds. Use this for
#             the PUBLIC demo — nobody waits 30 s on a link someone sent them.
# "mistral" = hosted, French. Best story for a French client, but the free tier
#             must be activated or every call comes back 429.
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=300
# Must stay above the context budget in generator.build_context — Ollama's
# default of 2048 silently truncates the extracts.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=350
OLLAMA_KEEP_ALIVE=30m

# console.groq.com — free, no credit card. The base URL is separate because the
# endpoint speaks the OpenAI protocol: point it at Together, OpenRouter or a
# self-hosted vLLM and nothing else changes.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq retires models regularly; if a call returns model_not_found, list the
# live catalogue:  curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $KEY"
GROQ_MODEL=openai/gpt-oss-120b

MISTRAL_API_KEY=your_mistral_key_here
LLM_MODEL=mistral-small-latest

# ---- Embeddings (local, no data leaves the host) ----
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# ---- Reranker (cross-encoder, multilingual, ~120M params) ----
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20

# ---- Vector store ----
CHROMA_PATH=./chroma_db
COLLECTION_NAME=sme_hr_corpus

# ---- Chunking ----
CHUNK_SIZE=1400
CHUNK_OVERLAP=200

# ---- Retrieval / guardrails ----
TOP_K=5
MIN_SIMILARITY=0.72
MIN_RERANK_SCORE=0.0
MAX_QUESTION_LENGTH=500
RATE_LIMIT=10/minute

# ---- Paths ----
DOCUMENTS_PATH=./data/documents
